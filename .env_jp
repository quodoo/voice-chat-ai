# --- CẤU HÌNH TIẾNG NHẬT (Mac M4 Local) ---

# Fix FFmpeg duplicate warning on Mac
DYLD_LIBRARY_PATH=

# 1. BỘ NÃO (BRAIN): Dùng Ollama với model Nhật
MODEL_PROVIDER=ollama

# Chọn nhân vật giáo viên tiếng Nhật
CHARACTER_NAME=japanese_teacher
LANGUAGE_CODE=ja

# 2. CÁI MIỆNG (TTS - NÓI): Dùng Kokoro với giọng Nhật
TTS_PROVIDER=kokoro

# Giọng Kokoro tiếng Nhật (đàn ông):
# jm_kumo - Giọng nam Nhật duy nhất
KOKORO_TTS_VOICE=jm_kumo

# Tốc độ nói (1.0 là chuẩn, 0.9 chậm hơn để nghe rõ tiếng Nhật)
VOICE_SPEED=0.9

# 3. CÁI TAI (STT - NGHE): Dùng Whisper (Local)
FASTER_WHISPER_LOCAL=true

# --- CẤU HÌNH CHI TIẾT OLLAMA ---

# Đường dẫn chuẩn
OLLAMA_BASE_URL=http://localhost:11434

# Model AI cho tiếng Nhật:
# qwen2.5:3b - TỐT NHẤT cho tiếng Nhật (hỗ trợ kanji/hiragana/katakana)
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_MODEL=llama3.2:3b  

# --- CẤU HÌNH TỐI ƯU TỐC ĐỘ ---

# Giới hạn ký tự - tiếng Nhật ngắn gọn hơn tiếng Anh
MAX_CHAR_LENGTH=200


# --- CÁC CẤU HÌNH KHÁC ---

COQUI_TOS_AGREED=1

# Endpoints
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_TTS_URL=https://api.openai.com/v1/audio/speech
XAI_BASE_URL=https://api.x.ai/v1
KOKORO_BASE_URL=http://localhost:8880/v1

# Debug
DEBUG=false
DEBUG_AUDIO_LEVELS=false

# --- CÁC KEY API (ĐỂ TRỐNG VÌ DÙNG LOCAL) ---
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
